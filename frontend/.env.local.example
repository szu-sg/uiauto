# 本地前端环境变量（复制为 frontend/.env.local，勿提交 Git）

# 后端 API 代理目标（Vite dev server 默认 5180）
VITE_API_PROXY=http://localhost:3001

# 仅开发模式生效：免 WPS SSO 登录（npm run dev 时）
# 生产构建（npm run build）不会启用此项
# VITE_AUTH_DISABLED=true

# 本机 Playwright 调试运行器（默认 http://127.0.0.1:9321）
# VITE_LOCAL_RUNNER_URL=http://127.0.0.1:9321
