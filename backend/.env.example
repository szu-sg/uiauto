# UIAuto 后端环境变量示例（复制为 backend/.env）
# 生产环境务必修改 JWT_SECRET，并在 WPS 开放平台登记 WPS_REDIRECT_URI

# ── 服务 ──
HOST=0.0.0.0
PORT=3001

# ── JWT（生产必填，随机长字符串）──
JWT_SECRET=change-me-in-production

# ── WPS 企业 SSO OAuth2（与 CSR 质量评测同一套应用时可复用凭证）──
WPS_APPID=854bb91c-5ef2-11f1-adfe-dee35356ca96
WPS_APPKEY=ckz7yJd0v5482wKteXqNVh6UQ93ZOmW1
# 须与 WPS 开放平台登记完全一致（含尾斜杠）
# 本地 Vite 开发：http://localhost:5180/
# 生产单端口：http://<服务器IP>:3001/
WPS_REDIRECT_URI=http://localhost:5180/

# 逗号分隔：首次 SSO 登录即授予 super_admin（可选）
# WPS_SUPER_ADMIN_EMAILS=wangjindong@wps.cn

# ── 仅本地调试：设为 1 跳过登录（生产切勿开启）──
# AUTH_DISABLED=1

# ── Playwright 服务端执行 ──
SKIP_PLAYWRIGHT_DEPS=1
# 试跑队列并发数（默认 2）
RUN_WORKER_CONCURRENCY=2

# ── 可选：协作群通知 ──
# WPS_NOTIFY_ENABLED=1
# WPS_WEBHOOK_URL=https://xz.wps.cn/api/v1/webhook/send?key=xxx
# UIAUTO_PUBLIC_BASE_URL=http://<服务器IP>:3001
